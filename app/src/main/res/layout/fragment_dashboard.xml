<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name_analysis"
            android:textColor="@color/maroon_primary"
            android:textStyle="bold"
            android:textSize="28sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp" />

        <!-- Search Bar -->
        <EditText
            android:id="@+id/et_search_bar"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="Search"
            android:paddingStart="40dp"
            android:background="@drawable/rounded_search_bar"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:textColorHint="#B0B0B0"
            android:textColor="@color/black" />

        <!-- Monitored Applications -->
        <TextView
            android:id="@+id/tv_monitored_apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitored Applications"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginTop="20dp" />

        <!-- Shopee card -->
        <LinearLayout
            android:id="@+id/card_shopee"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_card_bg"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Shopee Logo -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/shopee_logo" />

            <!-- Shopee Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shopee"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.6 / 5 Bintang"
                    android:textColor="@color/dark_grey"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Donut Chart & Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <com.example.stratify.DonutChartView
                    android:id="@+id/donut_chart"
                    android:layout_width="140dp"
                    android:layout_height="80dp"
                    android:background="@android:color/transparent" />

                <Button
                    android:id="@+id/btnViewFullAnalysis"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/rounded_button_bg"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="View Full Analysis"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Recently viewed apps -->
        <TextView
            android:id="@+id/tv_recently_viewed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recently Viewed Apps"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

        <HorizontalScrollView
            android:id="@+id/scroll_recently_viewed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView android:src="@drawable/lazada_logo" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp"/>
                <ImageView android:src="@drawable/amazon_logo" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp"/>
                <ImageView android:src="@drawable/tokopedia_logo" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp"/>
                <ImageView android:src="@drawable/bukalapak_logo" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Recommendation Apps -->
        <TextView
            android:id="@+id/tv_recommendation_apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recommendation Apps"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:id="@+id/layout_recommendation_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <include layout="@layout/item_recommendation_app" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
