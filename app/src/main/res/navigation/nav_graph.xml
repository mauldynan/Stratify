<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.stratify.FragmentDashboard"
        android:label="fragment_dashboard"
        tools:layout="@layout/fragment_dashboard" >
        <action
            android:id="@+id/action_navigation_home_to_fullAnalysisFragment"
            app:destination="@id/fullAnalysisFragment" />
        <action
            android:id="@+id/action_navigation_home_to_navigation_scrum"
            app:destination="@id/navigation_scrum" />
    </fragment>

    <fragment
        android:id="@+id/navigation_scrum"
        android:name="com.example.scrum_section.ScrumFragment"
        android:label="fragment_scrum"
        tools:layout="@layout/fragment_scrum" >
        <action
            android:id="@+id/action_navigation_scrum_to_navigation_home"
            app:destination="@id/navigation_home" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.stratify.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/fullAnalysisFragment"
        android:name="com.example.stratify.FullAnalysisFragment"
        android:label="activity_full_analysis"
        tools:layout="@layout/fragment_full_analysis" />
</navigation>