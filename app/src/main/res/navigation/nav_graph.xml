<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.stratify.FragmentDashboard"
        android:label="fragment_dashboard"
        tools:layout="@layout/fragment_dashboard" >
        <action
            android:id="@+id/action_dashboardFragment_to_fullAnalysisFragment"
            app:destination="@id/fullAnalysisFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.stratify.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/fullAnalysisFragment"
        android:name="com.example.stratify.FullAnalysisFragment"
        android:label="activity_full_analysis"
        tools:layout="@layout/fragment_full_analysis" />
</navigation>