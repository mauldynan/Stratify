<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.stratify.FragmentDashboard"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_dashboard" >
        <action
            android:id="@+id/action_dashboardFragment_to_fullAnalysisFragment"
            app:destination="@id/fullAnalysisFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_scrum"
        android:name="com.example.scrum_section.ScrumFragment"
        android:label="@string/title_scrum"
        tools:layout="@layout/fragment_scrum" />

    <fragment
        android:id="@+id/navigation_workspace"
        android:name="com.example.stratify.StartFragment"
        android:label="fragment_start"
        tools:layout="@layout/fragment_start" >
        <action
            android:id="@+id/action_startFragment_to_createWorkspaceFragment"
            app:destination="@id/createWorkspaceFragment" />
        <action
            android:id="@+id/action_startFragment_to_joinWorkspaceFragment"
            app:destination="@id/joinWorkspaceFragment" />
        <argument
            android:name="showBackButton"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <fragment
        android:id="@+id/fullAnalysisFragment"
        android:name="com.example.stratify.FullAnalysisFragment"
        android:label="fragment_full_analysis"
        tools:layout="@layout/fragment_full_analysis" />
    <fragment
        android:id="@+id/createWorkspaceFragment"
        android:name="com.example.stratify.CreateWorkspaceFragment"
        android:label="fragment_create_workspace"
        tools:layout="@layout/fragment_create_workspace" >
        <action
            android:id="@+id/action_createWorkspaceFragment_to_workspaceListFragment"
            app:destination="@id/workspaceListFragment"
            app:popUpTo="@id/navigation_workspace"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/joinWorkspaceFragment"
        android:name="com.example.stratify.JoinWorkspaceFragment"
        android:label="fragment_join_workspace"
        tools:layout="@layout/fragment_join_workspace" >
        <action
            android:id="@+id/action_joinWorkspaceFragment_to_workspaceListFragment"
            app:destination="@id/workspaceListFragment"
            app:popUpTo="@id/navigation_workspace"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/workspaceListFragment"
        android:name="com.example.stratify.WorkspaceListFragment"
        android:label="WorkspaceListFragment"
        tools:layout="@layout/fragment_workspace_list">
        <action
            android:id="@+id/action_workspaceListFragment_to_startFragment"
            app:destination="@id/navigation_workspace"
            app:popUpTo="@id/navigation_workspace"
            app:popUpToInclusive="true">
            <argument
                android:name="showBackButton"
                android:defaultValue="true" />
        </action>
        <action
            android:id="@+id/action_workspaceListFragment_to_workspaceDetailFragment"
            app:destination="@id/workspaceDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/workspaceDetailFragment"
        android:name="com.example.stratify.WorkspaceDetailFragment"
        android:label="fragment_workspace_detail"
        tools:layout="@layout/fragment_workspace_detail" >
        <argument
            android:name="workspace"
            app:argType="com.example.stratify.Workspace" />
    </fragment>

</navigation>